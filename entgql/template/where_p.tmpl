{{/* The line below tells Intellij/GoLand to enable the autocompletion based on the *gen.Graph type. */}}
{{/* gotype: entgo.io/ent/entc/gen.Graph */}}

{{ define "where_p" }}

{{/* Add the base header for the generated file */}}
{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

{{/* Loop over all nodes and implement the "WhereP" interface */}}
{{ range $n := $.Nodes }}
    {{ $receiver := $n.Receiver }}
    // WhereP appends storage-level predicates to the NodeQuery builder. Using this method,
    // users can use type-assertion to append predicates that do not depend on any generated package.
    func ({{ $receiver }} *{{ (print $n.Name "Query") }}) WhereP(ps ...func(*sql.Selector)) {
        p := make([]predicate.{{ $n.Name }}, len(ps))
        for i := range ps {
            p[i] = ps[i]
        }
        {{$receiver}}.Where(p...)
    }
{{ end }}

{{ end }}
